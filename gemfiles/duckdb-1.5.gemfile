# frozen_string_literal: true

# The development bundle with the duckdb gem held at 1.5.x. CI runs one job with
# it, because projects that pin duckdb 1.5.x still use sequel-duckdb. Drop this
# file when DuckDB 1.5.x reaches end of life (March 2027); see AGENTS.md.
#
# Use it with BUNDLE_GEMFILE=gemfiles/duckdb-1.5.gemfile, for example
# BUNDLE_GEMFILE=gemfiles/duckdb-1.5.gemfile just test

source "https://rubygems.org"

gemspec path: ".."

gem "duckdb", "~> 1.5.0"
