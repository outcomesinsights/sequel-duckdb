#!/usr/bin/env bash
# Installs a DuckDB C library release (headers and libduckdb.so). CI runs it
# before bundler compiles the duckdb gem, once for each library version that
# CI tests. The gem version in Gemfile.lock does not decide the library
# version: ruby-duckdb 2.x builds against libduckdb 1.4 or newer.
#
# Usage: bin/install-libduckdb VERSION [PREFIX]
#   VERSION is a DuckDB release without the v, for example 1.5.6.
#   PREFIX defaults to /usr/local. sudo is used when PREFIX is not writable.
#
# DuckDB renamed the release file in 2.0: 1.x ships libduckdb-linux-amd64.zip,
# 2.x ships duckdb-shared-libs-linux-amd64.tar.gz. The 2.x Linux build needs an
# x86-64-v3 CPU (AVX2, BMI2); older CPUs crash with SIGILL when it loads.
#
# The script installs only a version whose asset SHA-256 is pinned below, and
# it stops when the download does not match. To pin another version, take the
# digest that GitHub records for the asset:
#   gh api repos/duckdb/duckdb/releases/tags/vVERSION \
#     --jq '.assets[] | select(.name=="ASSET") | .digest'
# and check that sha256sum of a download gives the same value.
set -euo pipefail

version=${1:?usage: bin/install-libduckdb VERSION [PREFIX]}
prefix=${2:-/usr/local}

major=${version%%.*}
if ((major >= 2)); then
  asset=duckdb-shared-libs-linux-amd64.tar.gz
else
  asset=libduckdb-linux-amd64.zip
fi
case "$version" in
  1.5.6) sha256=b845005f5132a7d8180057c35e14a7626632258782f871a90861b19c1c03841b ;;
  2.0.0) sha256=993ad89e7dfca66cd6da994c2cad090c2fc160ddf9f550498a098ab4bb13cfb1 ;;
  *)
    echo "bin/install-libduckdb: no SHA-256 is pinned for DuckDB v${version}; pin one in this script" >&2
    exit 1
    ;;
esac
url="https://github.com/duckdb/duckdb/releases/download/v${version}/${asset}"
echo "Installing DuckDB v${version} from ${asset} into ${prefix}"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL -o "$tmp/$asset" "$url"
echo "${sha256}  $tmp/$asset" | sha256sum --check --strict -
mkdir "$tmp/lib"
case "$asset" in
  *.zip) unzip -q "$tmp/$asset" -d "$tmp/lib" ;;
  *.tar.gz) tar -xzf "$tmp/$asset" -C "$tmp/lib" ;;
esac

sudo=""
if ! mkdir -p "$prefix/include" "$prefix/lib" 2>/dev/null || [ ! -w "$prefix/lib" ]; then
  sudo=sudo
  sudo mkdir -p "$prefix/include" "$prefix/lib"
fi
find "$tmp/lib" -maxdepth 1 -name 'duckdb*.h*' -exec $sudo install -m 0644 {} "$prefix/include/" \;
$sudo install -m 0755 "$tmp/lib/libduckdb.so" "$prefix/lib/"
if [ "$prefix" = /usr/local ]; then
  $sudo ldconfig "$prefix/lib"
fi
echo "Installed DuckDB v${version} into ${prefix}"
